+}
+
+// saveEvent imports an event into strfry's DB.
+// NOTE: `strfry import` only parses newline-terminated lines, and
+// eventstore/strfry's SaveEvent sends the JSON without a trailing newline,
+// which makes it silently fail. We therefore invoke strfry ourselves and
+// append the newline.
+func saveEvent(evt *nostr.Event) error {
+	j, err := json.Marshal(evt)
+	if err != nil {
+		return err
+	}
+	j = append(j, '\n')
+	cmd := exec.Command(strfrydb.ExecutablePath, "--config="+strfrydb.ConfigPath, "import", "--show-rejected", "--no-verify")
+	cmd.Stdin = bytes.NewReader(j)
+	return cmd.Run()
+}
+
